# Milestone 0: No backend, database, or external API keys required.
# PostgreSQL connection string used by server-side database queries (never expose to client code)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/learn_german_daily

# Optional direct PostgreSQL URL for migrations/tooling if DATABASE_URL uses a connection pooler
DATABASE_DIRECT_URL=postgresql://postgres:postgres@localhost:5432/learn_german_daily

# Optional content provider mode: "database" | "local"
CONTENT_PROVIDER=database

# Optional public site origin for SEO canonicals, robots.txt, and sitemap.xml
NEXT_PUBLIC_SITE_URL=